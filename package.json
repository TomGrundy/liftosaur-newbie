{
  "name": "liftosaur-newbie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Beginner Liftosaur programs: static site, generator CLI and uploader",
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:programs": "tsx src/cli/index.ts validate programs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "commander": "^15.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
